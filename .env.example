# Default: free public Hugging Face FLUX demo, no API key required.
# Shared queue and daily quota apply; this is a debugging service, not an SLA.
IMAGE_PROVIDER=hf_space
TEXT_PROVIDER=basic
HF_SPACE_URL=https://black-forest-labs-flux-1-schnell.hf.space
HF_TOKEN=

# Optional Gemini connection. Native image APIs may require paid quota.
# IMAGE_PROVIDER=gemini
# TEXT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Optional compatible service: chat/completions and images/generations.
# TEXT_PROVIDER=compatible
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=
# IMAGE_PROVIDER=compatible
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
# Allowlisted HTTPS image CDN hostnames, comma-separated (only for URL results).
IMAGE_ALLOWED_HOSTS=
